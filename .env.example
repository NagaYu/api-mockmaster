# Copy to .env and fill in. NEVER commit the real .env.

# REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=

# Database. Default is local SQLite; switch to Postgres for production:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/mockmaster
DATABASE_URL=sqlite:///./mockmaster.db

# Session lifetime (hours).
ACCESS_TOKEN_TTL_HOURS=168

# Auto-create tables on boot (dev convenience). Set to 0 in production and rely
# on `alembic upgrade head` as the single source of truth for the schema.
AUTO_CREATE_TABLES=1

# Abuse guards.
MAX_MOCKS_PER_USER=200
MAX_RESPONSE_BYTES=102400
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60
